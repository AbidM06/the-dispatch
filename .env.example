# ── The Dispatch — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# ── API Keys ──────────────────────────────────────────────────────────────────

# Anthropic — get from console.anthropic.com
# Required for: /api/events (refresh), /api/risk (refresh), /api/explain/:ticker
# NOT required when LOW_COST_MODE=true
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — get from platform.openai.com
# Optional: used as fallback when Claude Sonnet is overloaded or fails to parse JSON
# Affects: /api/research/report (macro, commodities, equity, thematic types)
# If not set, falls back to static deterministic narrative instead
OPENAI_API_KEY=sk-...
# OPENAI_FALLBACK_MODEL=gpt-4o   # default; override to gpt-4o-mini for lower cost

# Alpha Vantage — get free key from alphavantage.co
# Free tier: 25 req/day, 5 req/min (cache minimises usage)
# Required for: /api/snapshot (watchlist prices, FX rate)
ALPHA_VANTAGE_API_KEY=demo

# FRED (St. Louis Fed) — get free key from fred.stlouisfed.org/docs/api/fred/
# Required for: /api/snapshot (DGS10, DFII10, T10YIE, BAMLH0A0HYM2, T10Y2Y)
FRED_API_KEY=your_fred_key_here

# Finnhub — get free key at finnhub.io (60 req/min, no daily cap)
# Required for: /api/news, live earnings/economic calendar, news sentiment
FINNHUB_API_KEY=

# EIA (U.S. Energy Information Administration) — get free key from eia.gov/opendata
# Required for: /api/research/report?type=commodities (WTI, Brent, Henry Hub NG price history)
# Free tier: no daily cap for reasonable usage
EIA_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────

# Server port (default 3001)
PORT=3001

# ── Cost Controls ─────────────────────────────────────────────────────────────

# LOW_COST_MODE — set to true to disable all Anthropic API calls.
# GET /events and /risk will return deterministic rule-based narrative instead.
# POST /refresh will also return deterministic (pass force:true to call AI anyway).
# Ideal for demos, development, and when Anthropic credits are low.
# LOW_COST_MODE=false

# Hard block on ALL Anthropic calls regardless of budget or mode.
# DISABLE_AI=false

# Anthropic call budget (in-process counters, reset each UTC day/month).
# Set to 0 to disable that dimension of gating.
# ANTHROPIC_DAILY_CAP=5
# ANTHROPIC_MONTHLY_CAP=50

# ── Institutional Research (five-agent pipeline) ─────────────────────────────

# Master switch for the five-agent research pipeline (Lead Analyst → Data
# Auditor + Red Team + Cross-Asset PM in parallel → IC Chair → quality gate).
# Default: true. Set to false to fall back to single-call report generation
# (reports are still versioned/interrogable but QA is honestly labelled NOT RUN).
# RESEARCH_MULTI_AGENT=true

# Minimum weighted IC score (0-100) required for APPROVED status. Default 85.
# RESEARCH_MIN_QA_SCORE=85

# Max targeted revision rounds after a failed quality gate. Default 2.
# RESEARCH_MAX_VALIDATION_ROUNDS=2

# Hard cap on total agent LLM calls per report generation. Default 8.
# (Base pipeline uses 6: draft, claim extraction, auditor, red team, PM, chair.
#  Each revision round adds 2: revise + chair re-score.)
# RESEARCH_MAX_AGENT_CALLS=8

# NOTE: each agent call passes through the shared ANTHROPIC_DAILY_CAP /
# ANTHROPIC_MONTHLY_CAP budget. A full five-agent run uses ~6-8 calls, so
# raise the daily cap (e.g. 15) if you use multi-agent research regularly.

# Per-role model overrides (defaults: Sonnet everywhere except claim
# extraction, which uses Haiku). The lead DRAFT reuses the existing per-type
# model chain (Sonnet → OpenAI → Haiku); RESEARCH_LEAD_MODEL governs the
# revision step.
# RESEARCH_LEAD_MODEL=claude-sonnet-4-5-20250929
# RESEARCH_EXTRACT_MODEL=claude-haiku-4-5-20251001
# RESEARCH_AUDITOR_MODEL=claude-sonnet-4-5-20250929
# RESEARCH_REDTEAM_MODEL=claude-sonnet-4-5-20250929
# RESEARCH_PORTFOLIO_MODEL=claude-sonnet-4-5-20250929
# RESEARCH_CHAIR_MODEL=claude-sonnet-4-5-20250929
# RESEARCH_CHAT_MODEL=claude-sonnet-4-5-20250929

# ── Equity pitch generator ────────────────────────────────────────────────────

# POST /api/pitch/:ticker — manual, on-demand single-stock pitch (Sonnet +
# web_search). Never called by schedulers — user-triggered only. Cached 24h
# per ticker unless a `context` body field is supplied (always live) or
# ?force=true is passed.
# CACHE_TTL_PITCH=1440

# ── Strategy backtester ───────────────────────────────────────────────────────

# GET /api/analytics/strategy-backtest — technical strategy backtest engine
# (server/engine/tradingStrategies.js + metrics.js). Pure computation, no AI
# calls. Price history comes from Polygon (US tickers/ADRs/ETFs, requires
# POLYGON_API_KEY) or Yahoo Finance (native Asian listings ending in
# .KS/.KQ/.T/.TW/.HK/.SS/.SZ/.NS/.BO — no key required). Cached 30 min per
# (ticker, strategy, days, params).

# ── Cache TTLs ────────────────────────────────────────────────────────────────
# (all in minutes unless noted)

# CACHE_TTL_FRED=60         # 60 min for FRED series
# CACHE_TTL_EVENTS=1440     # 24 h for AI events / risk / econ (saves credits)

# ── Cooldowns ─────────────────────────────────────────────────────────────────

# Minimum minutes between POST /events/refresh and /risk/refresh calls.
# Cooldown is shared — refreshing events also resets risk cooldown and vice versa.
# Use force:true in POST body to bypass (e.g. for manual demo refresh).
# EVENTS_COOLDOWN_MIN=60

# ── Markets panel (free data) ────────────────────────────────────────────────
# Prices come from free sources: Yahoo Finance (no key), FRED (FRED_API_KEY),
# Finnhub (FINNHUB_API_KEY, US-stock fallback), ECB via Frankfurter (no key)
# and Polymarket (no key). One automatic refresh per weekday, run inside the
# server, with catch-up if the Mac was asleep; "Refresh now" in the UI for more.
# MARKETS_REFRESH_TIME=14:45          # HH:MM in MARKETS_TZ
# MARKETS_TZ=Europe/London
# MARKETS_SCHEDULE=on                 # set to "off" to disable the daily run
# POLYMARKET_TAGS=economy,geopolitics # which prediction-market topics to show
# POLYMARKET_COUNT=4

# ── Trade idea cards (News + Research tabs) ──────────────────────────────────
# On-demand only: one Claude call per idea (~$0.02–0.05), no web search,
# counted against ANTHROPIC_DAILY_CAP / ANTHROPIC_MONTHLY_CAP. View-only.
# IDEAS_MODEL=claude-sonnet-4-5-20250929

# ── Write-auth (protects mutating endpoints) ─────────────────────────────────
# Set to a secret string to require x-dispatch-key header on POST/PATCH/DELETE.
# Leave unset for dev mode (open access).
# DISPATCH_ADMIN_KEY=

# ── Running in low-cost / no-API mode ────────────────────────────────────────
#
# To run The Dispatch with zero paid API calls:
#
#   LOW_COST_MODE=true         # deterministic narrative everywhere
#   DISABLE_AI=true            # belt-and-braces AI block
#   ALPHA_VANTAGE_API_KEY=demo # AV demo key (1 ticker, limited)
#   FRED_API_KEY=              # FRED is free but optional; seeds used as fallback
#
# The app will still show meaningful market analysis derived from seeded FRED
# rates and macro data — no API calls required.
