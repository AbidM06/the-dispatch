# ── The Dispatch — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to version control (.gitignore already excludes it).
#
# On a Mac the file is hidden in Finder because its name starts with a dot —
# press Cmd+Shift+. to show hidden files, or edit it in Terminal:
#   nano .env        (Ctrl+O to save, Ctrl+X to exit)
# Avoid TextEdit: it can silently save as ".env.txt", which the app never reads.
# The server only reads .env at start-up — restart it after editing.

# ── API Keys ──────────────────────────────────────────────────────────────────

# Anthropic — console.anthropic.com. Powers research reports, idea cards,
# events/risk analysis, explain, pitch and interrogation.
# NOT required when LOW_COST_MODE=true.
ANTHROPIC_API_KEY=sk-ant-...

# FRED (St. Louis Fed) — free key from fred.stlouisfed.org/docs/api/fred/
# Markets panel rates/credit/macro series, and the VERIFIED MARKET DATA every
# research report is built on (11 series incl. Brent, WTI, VIX, EUR/USD).
FRED_API_KEY=your_fred_key_here

# Finnhub — free key at finnhub.io (60 req/min, no daily cap)
# News, earnings/economic calendar, sentiment; US-stock price fallback.
FINNHUB_API_KEY=

# EIA (U.S. Energy Information Administration) — free key from eia.gov/opendata
# Commodities report price-history chart (WTI, Brent, Henry Hub).
EIA_API_KEY=

# Polygon.io — free key from polygon.io/dashboard
# Strategy backtester / momentum history and the vol surface. Not used by Markets.
POLYGON_API_KEY=

# OpenAI — optional backup when Claude Sonnet fails. It has NO web search, so
# reports it writes are labelled "not grounded". Its calls appear on cost
# receipts as UNPRICED (billed by OpenAI, not in our price table).
# OPENAI_API_KEY=sk-...
# OPENAI_FALLBACK_MODEL=gpt-4o

# Alpha Vantage — no longer used by any route (provider kept for tests).
# ALPHA_VANTAGE_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── AI spend (US dollars) ────────────────────────────────────────────────────
#
# Every Claude call is priced from the token counts the API returns, at
# Anthropic list prices, and recorded in data/ai_spend.json (survives restarts).
# The caps below are DOLLARS — not call counts — per UTC day / month.
# Set a cap to 0 to disable it.
#
# Nothing spends money on a schedule: every AI feature runs only when you press
# its button (see "Scheduled AI jobs" below to opt back in).
#
# Rough guide (measured receipts replace these after your first runs):
#   one five-agent research report   ~ $0.40–1.20
#   one morning bulletin             ~ $0.15–0.40
#   one Events/Risk refresh          ~ $0.05–0.15
#   one trade idea card              ~ $0.02–0.05
#
# Daily cap: a HARD stop — the guard against a runaway loop.
# ANTHROPIC_DAILY_CAP=5
# Monthly cap: "warn" (default) lets you go over but shows a banner and warns in
# every refresh confirmation; "block" pauses AI until the 1st.
# ANTHROPIC_MONTHLY_CAP=20
# ANTHROPIC_MONTHLY_CAP_MODE=warn

# Manual research refreshes show a cost estimate and ask before running.
# Estimates above this many USD need confirmation (0 = always ask).
# RESEARCH_CONFIRM_ABOVE_USD=0

# LOW_COST_MODE=true disables all AI calls (reports show "unavailable").
# LOW_COST_MODE=false
# DISABLE_AI=true is a hard block on every AI call.
# DISABLE_AI=false

# ── Research reports (five-agent pipeline) ───────────────────────────────────
#
# Lead draft → claim extraction → FRED fact check (code, free) →
# Data Auditor + Red Team + Cross-Asset PM in parallel → IC Chair → quality gate.
# Every agent receives the verified FRED data. Set to false for one draft call
# per report (cheaper; QA honestly labelled NOT RUN).
# RESEARCH_MULTI_AGENT=true

# ── Scheduled AI jobs (all OFF by default — set to "on" to schedule) ─────────
# Morning bulletin, 07:00 UTC weekdays (BULLETIN_TIME_UTC to change).
# BULLETIN_SCHEDULE=off
# Events / risk / econ refresh, 07:30 weekdays (AI_REFRESH_TIME to change).
# AI_REFRESH_SCHEDULE=off
# Research reports pre-generated at 06:40 weekdays through the full pipeline,
# every call via the Message Batches API at 50%.
# RESEARCH_BATCH=off
# RESEARCH_BATCH_TIME=06:40
# RESEARCH_BATCH_TYPES=macro,fx,rates,thematic,equity,commodities,sector

# Minimum weighted IC score (0-100) for APPROVED. Default 85.
# RESEARCH_MIN_QA_SCORE=85
# Max targeted revision rounds after a failed quality gate. Default 2.
# RESEARCH_MAX_VALIDATION_ROUNDS=2
# Hard cap on agent calls per report. Default 8 (base 6; each revision +2).
# RESEARCH_MAX_AGENT_CALLS=8

# Which Sonnet every Sonnet job uses (research pipeline, interrogation chat,
# idea cards, the Sonnet report types). Haiku jobs are unaffected.
# Default claude-sonnet-5. To try Sonnet 5.5 (same list price per token):
# SONNET_MODEL=claude-sonnet-5-5

# Per-role model overrides — each beats SONNET_MODEL for one job. Defaults:
# SONNET_MODEL everywhere except claim extraction (Haiku 4.5). No date suffix.
# RESEARCH_LEAD_MODEL=claude-sonnet-5
# RESEARCH_EXTRACT_MODEL=claude-haiku-4-5
# RESEARCH_AUDITOR_MODEL=claude-sonnet-5
# RESEARCH_REDTEAM_MODEL=claude-sonnet-5
# RESEARCH_PORTFOLIO_MODEL=claude-sonnet-5
# RESEARCH_CHAIR_MODEL=claude-sonnet-5
# RESEARCH_CHAT_MODEL=claude-sonnet-5

# ── Markets panel (free data, no AI) ─────────────────────────────────────────
# Yahoo Finance (no key), FRED, Finnhub (US-stock fallback), ECB via Frankfurter
# (no key) and Polymarket (no key). Refreshes automatically on weekdays at each
# time below (London time by default), with ONE catch-up if the Mac was asleep.
# The Refresh button in the Markets tab works any time.
#   07:45 — before the LSE open (US close, overnight Asia, latest FRED)
#   14:45 — 15 min after the NYSE open
# MARKETS_REFRESH_TIMES=07:45,14:45
# MARKETS_TZ=Europe/London
# MARKETS_SCHEDULE=on                 # "off" disables automatic refreshes
# POLYMARKET_TAGS=economy,geopolitics
# POLYMARKET_COUNT=4

# ── Trade idea cards (News + Research tabs) ──────────────────────────────────
# On-demand only: one Claude call per idea, no web search. View-only.
# IDEAS_MODEL=claude-sonnet-5

# ── Equity pitch generator ────────────────────────────────────────────────────
# POST /api/pitch/:ticker — on-demand single-stock pitch (Sonnet 5 + web search).
# Cached 24h per ticker unless a `context` is supplied or ?force=true.
# CACHE_TTL_PITCH=1440

# ── Cache TTLs (minutes) ──────────────────────────────────────────────────────
# CACHE_TTL_FRED=60
# CACHE_TTL_EVENTS=1440

# ── Cooldowns ─────────────────────────────────────────────────────────────────
# Minimum minutes between POST /events/refresh and /risk/refresh (shared).
# EVENTS_COOLDOWN_MIN=60

# ── Write-auth (protects mutating endpoints) ─────────────────────────────────
# Set to a secret to require an x-dispatch-key header on POST/PATCH/DELETE.
# Leave unset for local use (open access).
# DISPATCH_ADMIN_KEY=
