# ── The Dispatch — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# ── API Keys ──────────────────────────────────────────────────────────────────

# Anthropic — get from console.anthropic.com
# Required for: /api/events (refresh), /api/risk (refresh), /api/explain/:ticker
# NOT required when LOW_COST_MODE=true
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — get from platform.openai.com
# Optional: used as fallback when Claude Sonnet is overloaded or fails to parse JSON
# Affects: /api/research/report (macro, commodities, equity, thematic types)
# If not set, falls back to static deterministic narrative instead
OPENAI_API_KEY=sk-...
# OPENAI_FALLBACK_MODEL=gpt-4o   # default; override to gpt-4o-mini for lower cost

# Alpha Vantage — get free key from alphavantage.co
# Free tier: 25 req/day, 5 req/min (cache minimises usage)
# Required for: /api/snapshot (watchlist prices, FX rate)
ALPHA_VANTAGE_API_KEY=demo

# FRED (St. Louis Fed) — get free key from fred.stlouisfed.org/docs/api/fred/
# Required for: /api/snapshot (DGS10, DFII10, T10YIE, BAMLH0A0HYM2, T10Y2Y)
FRED_API_KEY=your_fred_key_here

# Finnhub — get free key at finnhub.io (60 req/min, no daily cap)
# Required for: /api/news, live earnings/economic calendar, news sentiment
FINNHUB_API_KEY=

# EIA (U.S. Energy Information Administration) — get free key from eia.gov/opendata
# Required for: /api/research/report?type=commodities (WTI, Brent, Henry Hub NG price history)
# Free tier: no daily cap for reasonable usage
EIA_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────

# Server port (default 3001)
PORT=3001

# ── Cost Controls ─────────────────────────────────────────────────────────────

# LOW_COST_MODE — set to true to disable all Anthropic API calls.
# GET /events and /risk will return deterministic rule-based narrative instead.
# POST /refresh will also return deterministic (pass force:true to call AI anyway).
# Ideal for demos, development, and when Anthropic credits are low.
# LOW_COST_MODE=false

# Hard block on ALL Anthropic calls regardless of budget or mode.
# DISABLE_AI=false

# Anthropic call budget (in-process counters, reset each UTC day/month).
# Set to 0 to disable that dimension of gating.
# ANTHROPIC_DAILY_CAP=5
# ANTHROPIC_MONTHLY_CAP=50

# RESEARCH_BATCH_TIME — when the daily research batch runs (24h, Mon–Fri, local).
# All six research reports are submitted as a single Message Batches job, which
# costs 50% of the synchronous rate. Reports are cached 24h and nobody waits on
# them, so the extra minutes of latency cost nothing. Any report the batch fails
# to produce is regenerated synchronously at full price, so batching can only
# affect cost, never availability.
# Default 06:40 — ahead of the 07:30 AI refresh and the 09:37 price prefetch.
# RESEARCH_BATCH_TIME=06:40

# ── Cache TTLs ────────────────────────────────────────────────────────────────
# (all in minutes unless noted)

# CACHE_TTL_MARKET=5        # 5 min for Alpha Vantage prices and FX
# CACHE_TTL_FRED=60         # 60 min for FRED series
# CACHE_TTL_EVENTS=1440     # 24 h for AI events / risk / econ (saves credits)

# ── Cooldowns ─────────────────────────────────────────────────────────────────

# Minimum minutes between POST /events/refresh and /risk/refresh calls.
# Cooldown is shared — refreshing events also resets risk cooldown and vice versa.
# Use force:true in POST body to bypass (e.g. for manual demo refresh).
# EVENTS_COOLDOWN_MIN=60

# ── Idea Engine — Alpaca paper trading ───────────────────────────────────────

# Alpaca paper-trading account credentials.
# Get free account at app.alpaca.markets → Create Paper Account.
# SAFETY: BASE_URL must contain "paper" — the engine will refuse to order on live URLs.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Set to true to auto-POST engine-approved US ideas to Alpaca paper account.
# Default: false (ideas are logged only; no orders placed).
# Only AMD, NVDA, MSFT, TSLA, MU, AMAT, LRCX are supported (US-listed only).
ALPACA_AUTO_EXECUTE=false

# ── Idea Engine scheduler ─────────────────────────────────────────────────────

# Comma-separated HH:MM local times to run the engine on weekdays.
ENGINE_SCHEDULE=08:00,15:30

# Minimum minutes between engine runs (cooldown guard).
ENGINE_COOLDOWN_MIN=30

# ── Write-auth (protects mutating endpoints) ─────────────────────────────────
# Set to a secret string to require x-dispatch-key header on POST/PATCH/DELETE.
# Leave unset for dev mode (open access).
# DISPATCH_ADMIN_KEY=

# ── Execution framework ─────────────────────────────────────────────────────
# Master switch: must be true to allow any paper-order placement.
TRADING_ENABLED=false
# Auto-approve engine ideas for paper execution (requires TRADING_ENABLED=true).
AUTO_APPROVE_PAPER=false
# Max paper orders per engine run.
ALPACA_MAX_ORDERS_PER_RUN=2
# Max paper trades per UTC day.
MAX_TRADES_PER_DAY=3
# Max notional GBP per UTC day.
MAX_NOTIONAL_GBP_PER_DAY=250
# Max open positions.
MAX_OPEN_POSITIONS=5
# Max single ticker exposure as % of portfolio.
MAX_SINGLE_TICKER_EXPOSURE_PCT=20
# Max age (minutes) of snapshot data before auto-execution is skipped.
TRADING_DATA_MAX_AGE_MIN=20

# ── Position sizing ──────────────────────────────────────────────────────────
# Risk budget per trade as % of account equity.
RISK_PER_TRADE_PCT=0.5
# Max single position as % of account equity.
MAX_POSITION_PCT=8
# Min order notional in GBP (below this, order is blocked).
MIN_ORDER_NOTIONAL_GBP=25

# ── Bracket orders ──────────────────────────────────────────────────────────
# Place entry + TP + SL as a single order (limit-based).
# USE_BRACKET_ORDERS=false

# ── Webhook notifications for idea lifecycle events ────────────────────────
# WEBHOOK_URL=https://your-webhook.example.com/dispatch
# WEBHOOK_SECRET=optional-signing-secret

# ── Allowed Alpaca hosts (comma-separated) ──────────────────────────────────
# ALPACA_ALLOWED_HOSTS=paper-api.alpaca.markets

# ── Running in low-cost / no-API mode ────────────────────────────────────────
#
# To run The Dispatch with zero paid API calls:
#
#   LOW_COST_MODE=true         # deterministic narrative everywhere
#   DISABLE_AI=true            # belt-and-braces AI block
#   ALPHA_VANTAGE_API_KEY=demo # AV demo key (1 ticker, limited)
#   FRED_API_KEY=              # FRED is free but optional; seeds used as fallback
#
# The app will still show meaningful market analysis derived from seeded FRED
# rates and macro data — no API calls required.
